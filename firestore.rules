rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One shared document holds which items are marked as bought.
    match /wishlist/state {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['items'])
                            && request.resource.data.items is map;
      allow delete: if false;
    }
  }
}
